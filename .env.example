# Copy to .env.local for local dev. Set the same names in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- Database (Supabase, region ap-south-1 Mumbai) ---
# Transaction pooler, port 6543 (used by the app at runtime).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Session pooler, port 5432 (used only by `npm run db:migrate`).
DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Local dev without Supabase: `npm run db:local`, then
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres and DATABASE_MAX_CONNECTIONS=1

# --- CV file storage (Supabase Storage, private bucket "cvs") ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # server only; never exposed to the browser

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash        # stable pinned ID; never -preview or -latest
GEMINI_CONCURRENCY=2                 # CVs processed in parallel from the dashboard

# --- Resend ---
RESEND_API_KEY=                      # FULL ACCESS key: a sending-only key cannot cancel (Undo) or read email status
RESEND_WEBHOOK_SECRET=               # from Resend → Webhooks (whsec_...)
EMAIL_FROM="Arjun at Kargo <arjun@your-verified-domain>"   # testing without a domain: onboarding@resend.dev (delivers only to your own Resend account email)
EMAIL_REDIRECT_TO=delivered@resend.dev   # when set, every candidate email goes here instead. Clear only at real go-live.
ARJUN_EMAIL=                         # digest recipient and reply-to
BOOKING_URL=                         # Cal.com / Calendly link used in the Advance email

# --- App secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))") ---
ADMIN_PASSWORD=
SESSION_SECRET=
HMAC_SECRET=
CRON_SECRET=
APP_URL=http://localhost:3000
